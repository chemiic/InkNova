PORT=3000
CORS_ORIGIN=http://localhost:5173
# Public web origin used for Vipps returnUrl (defaults to CORS_ORIGIN)
WEB_ORIGIN=http://localhost:5173
CONTACT_TO=Kontakt@inknova.no
# Print shop inbox for fulfilled orders (defaults to CONTACT_TO)
COPYCAT_TO=Kontakt@inknova.no
SMTP_HOST=send.one.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kontakt@inknova.no
# Set MAIL_DRY_RUN=true to log emails instead of sending (local dev)
MAIL_DRY_RUN=true
# Set PAYMENT_DRY_RUN=true to skip live Vipps and complete orders immediately
PAYMENT_DRY_RUN=true
# Vipps MobilePay ePayment (required when PAYMENT_DRY_RUN=false)
VIPPS_ENV=test
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
# Admin panel (single account; reset by changing these and restarting)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_JWT_SECRET=change-me-in-production
# SQLite database path (defaults to ./data/inknova.db)
# DATABASE_PATH=
# Uploaded catalog/article images (defaults to ./uploads)
# UPLOAD_DIR=
