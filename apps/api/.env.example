PORT=3000
CORS_ORIGIN=http://localhost:5173
# Public web origin used for Vipps returnUrl (defaults to CORS_ORIGIN)
WEB_ORIGIN=http://localhost:5173
CONTACT_TO=Kontakt@inknova.no
# Print shop inbox for fulfilled orders (defaults to CONTACT_TO)
COPYCAT_TO=Kontakt@inknova.no
SMTP_HOST=send.one.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kontakt@inknova.no
# Set MAIL_DRY_RUN=true to log emails instead of sending (local dev)
MAIL_DRY_RUN=true
# Set PAYMENT_DRY_RUN=true to skip live Vipps and complete orders immediately
# (temporary invoice mode: customer pays via emailed invoice)
PAYMENT_DRY_RUN=true
# Vipps MobilePay ePayment (required when PAYMENT_DRY_RUN=false)
VIPPS_ENV=test
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
# Public HTTPS URL Vipps calls when a payment is accepted, captured, or dropped.
# Defaults to WEB_ORIGIN + /api/payments/vipps/webhook.
# Localhost is skipped: Vipps cannot reach it. The return page still confirms.
# VIPPS_WEBHOOK_URL=https://inknova.no/api/payments/vipps/webhook
# Optional. The API stores the secret from registration in the database.
# VIPPS_WEBHOOK_SECRET=
# Admin panel (single account; reset by changing these and restarting)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_JWT_SECRET=change-me-in-production
# SQLite database path (defaults to ./data/inknova.db)
# DATABASE_PATH=
# Uploaded catalog/article images (defaults to ./uploads)
# UPLOAD_DIR=
# Cleanup is manual only from Admin → Overview (no automatic deletion)
