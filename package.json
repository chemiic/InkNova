{
  "name": "inknova",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter @inknova/web --filter @inknova/api run dev",
    "dev:web": "pnpm --filter @inknova/web dev",
    "dev:api": "pnpm --filter @inknova/api dev",
    "build": "pnpm --filter @inknova/shared build && pnpm --filter @inknova/api build && pnpm --filter @inknova/web build",
    "lint": "pnpm -r run lint"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3"
}
